{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetBridge",
  "version": "0.3.0",
  "identifier": "dev.netbridge.desktop",
  "build": {
    "frontendDist": "../dist/browser",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetBridge",
        "width": 1240,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMkRBRjU0QUIyREVBRjUKUldUMTZpMnJWSzh0b2xXbEdrNE1KQ0kwOUIzenlkS25VQlVlWkRGQnBaS3RnVDlVU1FKeFBkWU4K",
      "endpoints": [
        "https://github.com/chinchindev/netbridge/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
